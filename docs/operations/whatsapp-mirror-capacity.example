# Backend DIA CHAT de staging
NODE_ENV=staging
MESSAGING_WEBHOOK_MIRROR_V1_ENABLED=true
MESSAGING_WEBHOOK_REPLAY_ENABLED=true

# Runner isolado do gate
MESSAGING_WEBHOOK_REPLAY_RUN=STAGING_ONLY
CAPACITY_ENVIRONMENT=staging
CAPACITY_TARGET_URL=https://diachat-staging.example
CAPACITY_SERVICE_TOKEN=<secret-store-reference>
CAPACITY_REPLAY_WHATSAPP_ID=<staging-connection-id>
CAPACITY_RECEIVER_METRICS_URL=https://n8n-staging.example/webhook/capacity-status
CAPACITY_RECEIVER_STATUS_TOKEN=<secret-store-reference>
CAPACITY_RPS=150
CAPACITY_DURATION_SECONDS=1800
CAPACITY_DRAIN_DEADLINE_SECONDS=900
